{
    "name": "prueba-tecnica/backend-contactos",
    "description": "API REST en PHP nativo para gestion de contactos y telefonos",
    "type": "project",
    "keywords": ["api", "rest", "php", "contactos", "prueba-tecnica"],
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\Config\\": "config/",
            "App\\Controllers\\": "controllers/",
            "App\\Models\\": "models/",
            "App\\Repositories\\": "repositories/",
            "App\\Routes\\": "routes/",
            "App\\Services\\": "services/",
            "App\\Utils\\": "utils/",
            "App\\Validators\\": "validators/"
        }
    },
    "scripts": {
        "check": [
            "@php -l public/index.php",
            "@php -r \"require 'vendor/autoload.php'; echo 'Autoload OK'.PHP_EOL;\""
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}