# Copia este archivo a .env y ajusta los valores segun tu entorno.
# NUNCA subas .env al repositorio.

# --- Base de datos ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=prueba_contactos
DB_USERNAME=root
DB_PASSWORD=

# --- Aplicacion ---
# Nivel de detalle de los errores. En produccion usar "production".
APP_ENV=development

# Origenes permitidos para CORS separados por coma.
# Ej: http://localhost:4200,http://localhost:80
APP_CORS_ALLOWED_ORIGINS=*